# Server
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Frontend base URL, used by the backend to render the print report for PDF generation
FRONTEND_BASE_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=kundali_user
DB_PASSWORD=change_me
DB_NAME=kundali_db
DB_CONNECTION_LIMIT=10

# JWT (admin/staff)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# JWT (customer accounts - separate secret so a compromised customer
# session can never be used to forge an admin/staff session or vice versa)
CUSTOMER_JWT_SECRET=change_this_to_a_different_long_random_string
CUSTOMER_JWT_EXPIRES_IN=30d

# Astrology provider (Free Astrology API - https://freeastrologyapi.com)
ASTROLOGY_PROVIDER=free_astrology_api
FREE_ASTROLOGY_API_KEY=
FREE_ASTROLOGY_API_BASE_URL=https://json.freeastrologyapi.com

# Geocoding provider (OpenStreetMap Nominatim - no key required, but set a valid contact per usage policy)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=UdayGuruji-Kundali/1.0 (contact@example.com)

# Timezone provider (TimeZoneDB - https://timezonedb.com)
TIMEZONEDB_API_KEY=
TIMEZONEDB_BASE_URL=https://api.timezonedb.com/v2.1

# Gemini AI - generates natural-language interpretation text FROM the real
# calculated chart data (personality summary, yoga/dosha explanations,
# dasha/transit narrative). It never computes planetary positions or
# chart facts itself - those always come from the astrology provider
# above. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
# Set to false to disable AI interpretations entirely (report still works,
# those sections are simply omitted) - useful if the key/quota is unavailable.
GEMINI_INTERPRETATIONS_ENABLED=true

# File uploads
UPLOAD_DIR=uploads
MAX_LOGO_SIZE_MB=2

# Rate limiting
KUNDALI_RATE_LIMIT_WINDOW_MINUTES=15
KUNDALI_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10

# Default admin (used only by seed script)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
