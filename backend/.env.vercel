# Paste this block into Vercel → Project → Settings → Environment Variables
# → "Import .env" (bulk paste box). Review every value marked CHANGE_ME
# before importing - these are placeholders, not real production secrets.

# Server
NODE_ENV=production
API_BASE_PATH=/api/v1

# CORS - set to your deployed frontend's real URL, not localhost
CORS_ORIGINS=https://CHANGE_ME.your-frontend-domain.com
FRONTEND_BASE_URL=https://CHANGE_ME.your-frontend-domain.com

# MySQL - must be a reachable cloud database; Vercel has no local DB
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=kundali_db
DB_CONNECTION_LIMIT=10

# JWT (admin/staff) - generate a new production secret, do not reuse dev
JWT_SECRET=CHANGE_ME_generate_a_new_random_64_char_secret
JWT_EXPIRES_IN=8h

# JWT (customer accounts) - generate a new production secret, do not reuse dev
CUSTOMER_JWT_SECRET=CHANGE_ME_generate_a_new_random_64_char_secret
CUSTOMER_JWT_EXPIRES_IN=30d

# Astrology provider (Free Astrology API - https://freeastrologyapi.com)
ASTROLOGY_PROVIDER=free_astrology_api
FREE_ASTROLOGY_API_KEY=5KnTOmQTD9AOUgwtULrl3sJHGExzABIL2Ci2LP20
FREE_ASTROLOGY_API_BASE_URL=https://json.freeastrologyapi.com

# Geocoding provider (OpenStreetMap Nominatim - no key required)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=UdayGuruji-Kundali/1.0 (prasannhiremath333@gmail.com)

# Timezone provider (TimeZoneDB - https://timezonedb.com)
TIMEZONEDB_API_KEY=OLLO891WH8L6
TIMEZONEDB_BASE_URL=https://api.timezonedb.com/v2.1

# Gemini AI - optional, generates narrative interpretation text
GEMINI_API_KEY=CHANGE_ME_get_key_at_https://aistudio.google.com/apikey
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_INTERPRETATIONS_ENABLED=true

# File uploads - local disk does not persist on Vercel serverless;
# switch to S3/Cloudinary if logo uploads need to survive across requests
UPLOAD_DIR=uploads
MAX_LOGO_SIZE_MB=2

# Rate limiting
KUNDALI_RATE_LIMIT_WINDOW_MINUTES=15
KUNDALI_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10

# Seed admin - only used by the one-off seed script, not runtime
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=CHANGE_ME@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
